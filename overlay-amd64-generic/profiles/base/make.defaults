# Initial value just for style purposes.
USE=""

CHROMEOS_KERNEL_SPLITCONFIG="chromiumos-x86_64-generic"
CHROMEOS_KERNEL_ARCH="x86_64"

# We assume that our 64bit baseline CPU supports at least
# MMX, SSE, SSE2, and SSE3.
# This aligns with Chrome requirements:
# SSE2: https://crbug.com/350175
# SSE3: https://docs.google.com/document/d/1QUzL4MGNqX4wiLvukUwBf6FdCL35kCDoEJTm2wMkahw/preview
BOARD_COMPILER_FLAGS="-march=x86-64 -msse3"
BOARD_RUSTFLAGS="-Ctarget-cpu=x86-64 -Ctarget-feature=+sse3"
USE="${USE} march_x86-64"

# Include many firmwares as this is a "generic" board and might run on a
# wide variety of platforms with who knows what kind of hardware.
# iwlwifi covers the Wi-Fi half of Intel cards; the ibt_* files are the
# Bluetooth half of the same silicon (btusb loads intel/ibt-*.sfi at every
# boot). Without them a T14's AX210 radio has working Wi-Fi and a dead,
# address-00:00 hci0.
LINUX_FIRMWARE="iwlwifi-all ibt_9260 ibt_9462 ibt_9560 ibt_ax200 ibt_ax201 ibt_ax203 ibt_ax210 ibt_ax211"

# Use LLVM amdgpu target when building LLVM.
LLVM_TARGETS="AMDGPU X86"

USE="${USE} containers kvm_host crosvm-gpu virtio_gpu"

USE="${USE} legacy_keyboard legacy_power_button sse kernel-5_15"

# Developer tooling in the image: the OOBE test API and an open DevTools
# port, which let us drive OOBE from the host. Both are genuine
# remote-control surfaces.
#
# RELEASE BUILDS MUST SET -colorburst_devtools. Nothing needs them any more --
# colorburst-provision creates the account via cryptohome directly -- they
# exist only for development.
#
# Deliberately not keyed off cros_debug: that flag is off when this board's
# packages are built, so gating on it would strip the tooling from dev images
# too, silently.
USE="${USE} colorburst_devtools"

# Graphical installer. Without this the only way to install is VT2, a root
# shell and `chromeos-install`, whose entire UI is "Are you sure (y/N)?".
# os_install_service plus Chrome's --allow-os-install is the flow ChromeOS
# Flex uses (overlay-reven sets the same flag); its installer-detection test
# (ROOT-B the same size as ROOT-A) is already true for our USB layout.
USE="${USE} os_install_service"

# LLVM is required to build the llvmpipe and radeon drivers.
USE="${USE} llvm"

# Enable camera HALv3
USE="${USE} arc-camera3"

# Enable vivid
USE="${USE} vivid"

# Enable hostap hwsim tests.
USE="${USE} wifi_hostap_test"

# Include the kernel in the base image.
USE="${USE} include_vmlinuz"

# Enable chromeos-config.
USE="${USE} unibuild has_chromeos_config_bsp"

# Enable Vulkan for ClusterFuzz.
USE="${USE} vulkan"

# Use legacy pre-Groot UI for initramfs and init script screens.
USE="${USE} legacy_firmware_ui"

# Enable a few more video cards as this is a generic board.
# colorburst: iris (Intel Gen8+, e.g. Tiger Lake laptops) and amdgpu so the
# image boots on real hardware, not just VMs. Without iris, Chrome's GPU
# process cannot allocate scanout buffers on an Intel laptop and crash-loops
# with "Could not find SharedImageBackingFactory ... Scanout" -- the screen
# stays black even though OOBE finished loading. virgl stays for the VMs.
VIDEO_CARDS="intel iris amdgpu llvmpipe nouveau radeon virgl"

# Virtual machines don't have physical TPMs.
# Enable TPM2.0 simulator on it.
USE="${USE} -tpm tpm2 tpm2_simulator tpm2_simulator_manufacturer"

# Enable vTPM proxy on it for driver-level TPM simulator.
USE="${USE} vtpm_proxy"

# No support for zero-copy on virtual machines.
USE="${USE} -video_capture_use_gpu_memory_buffer"

# Enable fscrypt v2 usage on 5.4+
USE="${USE} direncription_allow_v2"

# mesa-llvmpipe does not require this flag yet.
USE="${USE} -gpu_sandbox_start_early"

# Enable VKMS and drm_atomic for compositor testing on VMs
USE="${USE} vkms drm_atomic"

# Enable biod testing
USE="${USE} biod"

# Skip Crosier test binary deployment.
USE="${USE} exclude_crosier"

# Disable kdump.
USE="${USE} -kdump"
